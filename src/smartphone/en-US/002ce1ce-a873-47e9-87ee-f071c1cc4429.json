                  "day": ""
               }
            },
            {
               "type": 1,
               "uuid": "a648cecf-238e-4294-a012-3830ff833d67",
               "text": "Original Text",
               "page": "https://www.historytracers.org/index.html?page=class_content&arg=a648cecf-238e-4294-a012-3830ff833d67",
               "date_time": {
                  "type": "gregory",
                  "year": "2026",
                  "month": "",
                  "day": ""
               }
            }
         ],
         "text": [
            {
               "text": "#### The Table of Zero\n\nLet us use our rule with **a = 0** (repeating the number zero): no matter how many times we add zero, the result is always zero. See it with your own eyes:",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            },
            {
               "text": "<p style=\"font-family: monospace; font-size: 1.05em; text-align: center; line-height: 1.75; margin: 0.2em auto;\">0 × 0 = 0<br/>0 × 1 = 0<br/>0 × 2 = 0<br/>0 × 3 = 0<br/>0 × 4 = 0<br/>0 × 5 = 0<br/>0 × 6 = 0<br/>0 × 7 = 0<br/>0 × 8 = 0<br/>0 × 9 = 0<br/>0 × 10 = 0</p>",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            },
            {
               "text": "Did you notice? The result **R** never changes! No matter which number **N** we use, multiplying by zero always gives **0**.",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "157b30ee-cbd6-4bc2-afc2-5d1fccceb6a3",
         "prev": "",
         "jumpTo": "",
         "answer": null,
         "score": 1,
         "position": ""
      },
      {
