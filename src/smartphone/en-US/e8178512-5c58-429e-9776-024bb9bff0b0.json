         "smile": "party",
         "source_menu": [],
         "text": [
            {
               "text": "### Conclusion\n\nWe learned that there is an equality sign (=). When it is present, any change on one side must be repeated on the other side to maintain equality.",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
