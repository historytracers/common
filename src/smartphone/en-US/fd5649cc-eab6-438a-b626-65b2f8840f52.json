         "source_menu": [],
         "text": [
            {
               "text": "#### Let Us Think!\n\nOn the Yupana, is subtraction performed using the same movements as addition, but in reverse?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "1793892a-0bef-4cf5-87a4-750f9c1ed379",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
