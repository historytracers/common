         "source_menu": [],
         "text": [
            {
               "text": "#### Thinking\n\nMeasuring tells us how long an object is.\n\nCan we use it to check whether two objects are equal?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "68b7c7d1-39ee-4b1b-ba17-c74698eefcde",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
