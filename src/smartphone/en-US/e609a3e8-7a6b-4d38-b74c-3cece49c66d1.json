               }
            }
         ],
         "text": [
            {
               "text": "#### Example\n\nLook at the string on the ruler below. It starts at 0 and ends at the mark 5, so its length is 5.",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
