         "source_menu": [],
         "text": [
            {
               "text": "#### Let's Check Our Understanding\n\nWhen we add two numbers column by column, if a column sum is greater than 9, do we write the unit digit in the result and carry 1 to the next column?",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "50c6f3af-0f85-4663-9231-0b34e5083624",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
      {
         "id": "50c6f3af-0f85-4663-9231-0b34e5083624",
         "audio": "",
         "smile": "party",
         "source_menu": [
