         "smile": "thinking",
         "source_menu": [],
         "text": [
            {
               "text": "#### Growing\n\nIn our life, we grow taller in the vertical direction. The quipus also grow their numbers in the vertical direction.\n\nDoes the Yupana follow the same pattern?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "d3fbc16b-dd85-42b2-8f62-dacf76c584aa",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
      {
