               "uuid": "68227419-2430-4359-b902-f6cf87b8941d",
               "text": "Holmes, F. L.",
               "page": "https://books.google.com.br/books?hl=en&lr=&id=MLY-x9a393QC",
               "date_time": {
                  "type": "gregory",
