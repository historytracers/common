         ],
         "text": [
            {
               "text": "#### The Numbers Today\n\nThis first understanding of memory helps us understand the reason people reached conclusions about the Etruscan-Roman numbers we see today:",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
