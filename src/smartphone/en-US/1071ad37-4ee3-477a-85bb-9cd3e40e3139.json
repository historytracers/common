         ],
         "text": [
            {
               "text": "#### In Africa: Practicing with Bones\n\nEach mark carved on the bone represents one count. Use the buttons to add or remove marks until the bone shows the proposed number.",
               "source": [],
               "date_time": null,
               "isTable": false,
