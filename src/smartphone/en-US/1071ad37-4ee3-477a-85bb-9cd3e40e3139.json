nt-style=\"italic\">Australopithecus afarensis</text> <text x=\"225\" y=\"154\" font-size=\"14\" font-weight=\"bold\">HUMANS</text> <text x=\"180\" y=\"130\" font-size=\"14\" font-style=\"italic\">Homo rudolfensis</text> <text x=\"280\" y=\"130\" font-size=\"14\" font-style=\"italic\">Homo habilis</text> <text x=\"230\" y=\"120\" font-size=\"14\" font-style=\"italic\">Homo erectus</text> <text x=\"300\" y=\"113\" font-size=\"14\" font-style=\"italic\">Homo naledi</text> <text x=\"250\" y=\"90\" font-size=\"14\" font-style=\"italic\">Homo antecessor</text> <text x=\"150\" y=\"76\" font-size=\"14\" font-style=\"italic\">Homo neanderthalensis</text> <text x=\"350\" y=\"80\" font-size=\"14\" font-style=\"italic\">Homo heidelbergensis</text> <text x=\"300\" y=\"70\" font-size=\"14\" font-style=\"italic\">Homo sapiens</text> <text x=\"140\" y=\"67\" font-size=\"14\">Denisovan</text> <text x=\"390\" y=\"67\" font-size=\"14\" font-style=\"italic\">Homo floresiensis</text> <rect x=\"132\" y=\"291\" width=\"460\" height=\"39\" fill=\"rgba(255,249,73,0.2)\" /> <rect x=\"132\" y=\"213\" width=\"460\" height=\"39\" fill=\"rgba(255,249,73,0.2)\" /> <rect x=\"132\" y=\"135\" width=\"460\" height=\"39\" fill=\"rgba(255,249,73,0.2)\" /> <rect x=\"132\" y=\"57\" width=\"460\" height=\"39\" fill=\"rgba(255,249,73,0.2)\" /> <line x1=\"300\" y1=\"332\" x2=\"240\" y2=\"314\" stroke=\"black\" /> <line x1=\"300\" y1=\"332\" x2=\"360\" y2=\"314\" stroke=\"black\" /> <line x1=\"460\" y1=\"248\" x2=\"360\" y2=\"213\" stroke=\"black\" /> <line x1=\"460\" y1=\"248\" x2=\"540\" y2=\"213\" stroke=\"black\" /> <line x1=\"250\" y1=\"174\" x2=\"160\" y2=\"135\" stroke=\"black\" /> <line x1=\"250\" y1=\"174\" x2=\"340\" y2=\"135\" stroke=\"black\" /></svg>",
