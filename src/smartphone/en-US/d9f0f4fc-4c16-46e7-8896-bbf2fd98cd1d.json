         "source_menu": [],
         "text": [
            {
               "text": "#### Thinking\n\nIf there is nothing to count, is it possible to obtain a result different from zero?",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "379a3339-fe47-44da-abbc-99921790477e",
         "prev": "",
         "jumpTo": "",
         "answer": "no",
         "score": 2,
         "position": ""
      },
      {
         "id": "379a3339-fe47-44da-abbc-99921790477e",
         "audio": "",
         "smile": "nerd",
         "source_menu": [
            {
               "type": 1,
