               "date_time": {
                  "type": "gregory",
                  "year": "2013",
                  "month": "",
                  "day": ""
               }
            }
         ],
         "text": [
            {
               "text": "#### Small Numbers\n\nFor numbers between 1 and 9, we simply count the number of knots on the string. Each knot represents one unit.\n\nWhen a string has no knots, it represents the number zero.",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            },
            {
               "text": "<svg viewBox=\"0 0 320 320\" width=\"320\" height=\"320\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"20\" y1=\"24\" x2=\"300\" y2=\"24\" stroke=\"#8B6914\" stroke-width=\"6\" stroke-linecap=\"round\"/><line x1=\"100\" y1=\"24\" x2=\"100\" y2=\"270\" stroke=\"#C49A6C\" stroke-width=\"4\"/><line x1=\"180\" y1=\"24\" x2=\"180\" y2=\"270\" stroke=\"#C49A6C\" stroke-width=\"4\"/><line x1=\"260\" y1=\"24\" x2=\"260\" y2=\"270\" stroke=\"#C49A6C\" stroke-width=\"4\"/><circle cx=\"180\" cy=\"70\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"180\" cy=\"100\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"180\" cy=\"130\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"180\" cy=\"160\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"180\" cy=\"190\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"260\" cy=\"55\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"260\" cy=\"80\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"260\" cy=\"105\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"260\" cy=\"130\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"260\" cy=\"155\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"260\" cy=\"180\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"260\" cy=\"205\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"260\" cy=\"230\" r=\"9\" fill=\"#8B6914\"/><circle cx=\"260\" cy=\"255\" r=\"9\" fill=\"#8B6914\"/><text x=\"100\" y=\"305\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"24\" font-weight=\"bold\" fill=\"#2C3E50\">0</text><text x=\"180\" y=\"305\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"24\" font-weight=\"bold\" fill=\"#2C3E50\">5</text><text x=\"260\" y=\"305\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"24\" font-weight=\"bold\" fill=\"#2C3E50\">9</text></svg>",
               "source": null,
