      {
         "id": "7d19f039-627e-4940-a17f-f898ff9c9591",
         "audio": "",
         "smile": "thinking",
         "source_menu": [],
         "text": [
            {
               "text": "#### Let Us Think!\n\nA quipu records numbers using knots placed in different orders.\n\n**Can a quipu represent any number?**",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "5e52ae38-07b9-4c41-b50c-d9313c8f3388",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
      {
         "id": "5e52ae38-07b9-4c41-b50c-d9313c8f3388",
         "audio": "",
