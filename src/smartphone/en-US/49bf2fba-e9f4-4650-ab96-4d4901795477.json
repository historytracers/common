            }
         ],
         "text": [
            {
               "text": "#### Adding with Calculi\n\nAdd the two numbers on the calculi. The units are on the right and the tens on their left; when the units reach ten, carry 1 to the tens column.",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
