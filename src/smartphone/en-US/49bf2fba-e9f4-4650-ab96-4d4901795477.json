               }
            }
         ],
         "text": [
            {
               "text": "#### Adding with Bones\n\nAdd the two numbers and represent the sum with marks on the bone. Use the arrows to add or remove marks.",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
