                  "month": "",
                  "day": ""
               }
            }
         ],
         "text": [
            {
               "text": "#### Adding with Quipus\n\nAdd the two numbers and represent the sum with knots. Watch the ten knots in the units turn into one knot in the tens.",
               "source": null,
               "date_time": null,
               "isTable": false,
