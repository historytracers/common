         "text": [
            {
               "text": "#### Counting Like Ancient Humans\n\nLook at the marks on the bone. They look like our fingers. In this game you will do the reverse: look at hands with raised fingers, then place marks on the bone until the marks match the fingers.",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
