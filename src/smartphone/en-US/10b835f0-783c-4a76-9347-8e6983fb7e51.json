               }
            },
            {
               "type": 1,
               "uuid": "867d9985-b757-472a-8197-386486ec58d6",
               "text": "Original Text",
               "page": "https://www.historytracers.org/index.html?page=class_content&arg=867d9985-b757-472a-8197-386486ec58d6",
               "date_time": {
                  "type": "gregory",
                  "year": "2026",
                  "month": "",
                  "day": ""
               }
            }
         ],
         "text": [
            {
               "text": "#### Method and Discipline\n\nWhen we read the description of this factor, we think of social relations.\n\nThis organization reminds us of our families, of workers in their workplaces and, in general, of any place where more than one person works and lives together — keeping society as a whole organized.",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "d308aad8-d2a5-472e-a336-d779e8918025",
         "prev": "dcebed0c-f29a-40c8-9d3f-54e70fdf7ed0",
         "jumpTo": "",
