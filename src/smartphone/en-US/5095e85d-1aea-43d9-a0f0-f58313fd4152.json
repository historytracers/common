         "smile": "thinking",
         "source_menu": [],
         "text": [
            {
               "text": "#### Let Us Think!\n\nAdding the same object 10 times gives 10. Giving those 10 objects to one person leaves that person with all 10.\n\nDoes multiplying or dividing by 1 always give back the value we started with?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "9664975f-fc57-4bb9-8a4d-7f4486b2af6f",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
