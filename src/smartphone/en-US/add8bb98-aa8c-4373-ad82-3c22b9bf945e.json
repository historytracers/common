         "smile": "party",
         "source_menu": [
            {
               "type": 1,
               "uuid": "add8bb98-aa8c-4373-ad82-3c22b9bf945e",
               "text": "Original Text",
               "page": "https://www.historytracers.org/index.html?page=class_content&arg=add8bb98-aa8c-4373-ad82-3c22b9bf945e",
               "date_time": {
                  "type": "gregory",
                  "year": "2026",
                  "month": "",
                  "day": ""
               }
            }
         ],
         "text": [
            {
               "text": "#### Conclusion\n\nIn this class we measured with a ruler in two directions: horizontal and vertical. This helps us see whether two objects have the same width and the same height.\n\nThe comparison is not complete yet: two objects can match in both and still differ in other ways, such as color or shape.",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
