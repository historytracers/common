            {
               "type": 1,
               "uuid": "20b14681-88c0-438a-a273-a0902ae5db38",
               "text": "History Tracers Team — Our Sides Are Equal",
               "page": "https://www.historytracers.org/index.html?page=class_content&arg=20b14681-88c0-438a-a273-a0902ae5db38",
               "date_time": {
                  "type": "gregory",
