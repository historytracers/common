         ],
         "text": [
            {
               "text": "#### Method and Discipline\n\nSet aside time to practice every day, and respect your rest time.",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
