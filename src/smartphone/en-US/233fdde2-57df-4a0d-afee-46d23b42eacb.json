                  "type": "gregory",
                  "year": "2026",
                  "month": "",
                  "day": ""
               }
            }
         ],
         "text": [
            {
               "text": "#### The First Values\n\nTo understand Dhavit Prem's conclusion, let us multiply 3 by 2 with the Yupana, using a single Yupana row.\n\nThe first step is to put a marker on top of 3, as shown below.",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            },
            {
               "text": "<p data-custom=\"yupana-one-row-red-3\"></p>",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            }
         ],
         "desc": null,
