         "source_menu": [],
         "text": [
            {
               "text": "#### Let Us Think!\n\nMesoamerican numbers use a similar idea for the numbers from 1 to 10. Does this mean we can also place a symbol before 5 and 10 to represent 4 and 9?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "8829d904-5057-4221-b457-282dde62813b",
         "prev": "",
         "jumpTo": "",
         "answer": "no",
         "score": 2,
         "position": ""
      },
