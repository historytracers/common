         "answer": null,
         "score": 1,
         "position": ""
      },
      {
         "id": "4ea65579-0b5a-4a9a-91eb-8f4154bd8dcb",
         "audio": "",
         "smile": "happy",
         "source_menu": [
            {
               "type": 1,
               "uuid": "240800f3-ede4-4deb-9d4e-915a3a03fa68",
               "text": "History Tracers Team",
               "page": "https://github.com/historytracers/historytracers/tree/master/src/images",
               "date_time": {
                  "type": "gregory",
                  "year": "2024",
                  "month": "",
                  "day": ""
               }
