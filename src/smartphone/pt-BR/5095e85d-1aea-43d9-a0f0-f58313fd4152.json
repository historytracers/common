         "source_menu": [],
         "text": [
            {
               "text": "#### Vamos Pensar!\n\nSomar o mesmo objeto 10 vezes dá 10. Entregar esses 10 objetos a uma única pessoa deixa essa pessoa com os 10.\n\nMultiplicar ou dividir por 1 sempre devolve o valor do qual partimos?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "9664975f-fc57-4bb9-8a4d-7f4486b2af6f",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
