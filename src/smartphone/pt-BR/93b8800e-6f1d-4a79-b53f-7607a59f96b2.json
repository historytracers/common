         "smile": "happy",
         "source_menu": [],
         "text": [
            {
               "text": "#### Em nós\n\nJá vimos que podemos usar os números com as mãos, mas não só isso. Veja a baixo, podemos enumerar diferentes partes do nosso corpo com ele também.",
               "source": [],
               "date_time": null,
