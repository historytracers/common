r=\"middle\">4</text><text x=\"240\" y=\"138\" font-size=\"13\" fill=\"#555555\" text-anchor=\"middle\">5</text><text x=\"280\" y=\"138\" font-size=\"13\" fill=\"#555555\" text-anchor=\"middle\">6</text><text x=\"320\" y=\"138\" font-size=\"13\" fill=\"#555555\" text-anchor=\"middle\">7</text><text x=\"360\" y=\"138\" font-size=\"13\" fill=\"#555555\" text-anchor=\"middle\">8</text><text x=\"400\" y=\"138\" font-size=\"13\" fill=\"#555555\" text-anchor=\"middle\">9</text><text x=\"440\" y=\"138\" font-size=\"13\" fill=\"#555555\" text-anchor=\"middle\">10</text><text x=\"468\" y=\"106\" font-size=\"15\" fill=\"#333333\">N</text><circle cx=\"40\" cy=\"110\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"80\" cy=\"110\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"120\" cy=\"110\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"160\" cy=\"110\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"200\" cy=\"110\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"240\" cy=\"110\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"280\" cy=\"110\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"320\" cy=\"110\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"360\" cy=\"110\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"400\" cy=\"110\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"440\" cy=\"110\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/></svg></p>",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            },
            {
               "text": "*Gráfico 1: pontos da tabuada do zero.*\n\nQue surpresa, não é? Todos os pontos ficam exatamente sobre a linha horizontal, porque todo resultado é zero.",
               "source": [],
