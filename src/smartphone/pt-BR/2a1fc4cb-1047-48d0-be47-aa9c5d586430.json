         "source_menu": [],
         "text": [
            {
               "text": "#### Crescendo\n\nEm nossa vida, crescemos na direção vertical. Os quipus também crescem seus números na direção vertical.\n\nA Yupana segue o mesmo padrão?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "d3fbc16b-dd85-42b2-8f62-dacf76c584aa",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
