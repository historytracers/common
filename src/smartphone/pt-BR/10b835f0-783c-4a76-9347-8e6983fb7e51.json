                  "month": "",
                  "day": ""
               }
            },
            {
               "type": 1,
               "uuid": "867d9985-b757-472a-8197-386486ec58d6",
               "text": "Texto Original",
               "page": "https://www.historytracers.org/index.html?page=class_content&arg=867d9985-b757-472a-8197-386486ec58d6",
               "date_time": {
                  "type": "gregory",
                  "year": "2026",
                  "month": "",
                  "day": ""
               }
            }
         ],
         "text": [
            {
               "text": "#### A lei da moral\n\nA \"lei da moral\" é o princípio da harmonia: todas as pessoas estão de acordo com as regras.\n\nNa aprendizagem diária, isso significa que, sem estudar com constância — com tarefas que nos ajudam a entender melhor o que está ao redor —, podemos nos sentir inseguros diante do que não conhecemos.\n\nDica: estudar um pouco todos os dias treina a nossa coragem para enfrentar o desconhecido.",
               "source": [],
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "421173ab-6758-467a-a9db-28c90b4417ce",
         "prev": "f94521dd-6f1c-4ddc-a535-2fc07194daaa",
         "jumpTo": "",
         "answer": null,
         "score": 1,
         "position": ""
      },
      {
         "id": "421173ab-6758-467a-a9db-28c90b4417ce",
         "audio": "",
         "smile": "happy",
         "source_menu": [
            {
               "type": 0,
               "uuid": "d25bb0c3-74e9-4e14-bfdb-e58430d1a28d",
