         "smile": "thinking",
         "source_menu": [],
         "text": [
            {
               "text": "#### Vamos Pensar!\n\nMedir nos diz o comprimento de um objeto.\n\nPodemos usar isso para verificar se dois objetos são iguais?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "68b7c7d1-39ee-4b1b-ba17-c74698eefcde",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
