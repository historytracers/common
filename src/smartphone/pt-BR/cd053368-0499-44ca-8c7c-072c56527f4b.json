"306\" y2=\"365\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"306\" y=\"382\" font-size=\"12\" fill=\"#555555\" text-anchor=\"middle\">6</text><line x1=\"342\" y1=\"355\" x2=\"342\" y2=\"365\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"342\" y=\"382\" font-size=\"12\" fill=\"#555555\" text-anchor=\"middle\">7</text><line x1=\"378\" y1=\"355\" x2=\"378\" y2=\"365\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"378\" y=\"382\" font-size=\"12\" fill=\"#555555\" text-anchor=\"middle\">8</text><line x1=\"414\" y1=\"355\" x2=\"414\" y2=\"365\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"414\" y=\"382\" font-size=\"12\" fill=\"#555555\" text-anchor=\"middle\">9</text><line x1=\"450\" y1=\"355\" x2=\"450\" y2=\"365\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"450\" y=\"382\" font-size=\"12\" fill=\"#555555\" text-anchor=\"middle\">10</text><text x=\"496\" y=\"350\" font-size=\"14\" fill=\"#333333\" font-weight=\"bold\">N</text><line x1=\"85\" y1=\"360\" x2=\"95\" y2=\"360\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"78\" y=\"364\" font-size=\"12\" fill=\"#555555\" text-anchor=\"end\">0</text><line x1=\"85\" y1=\"332\" x2=\"95\" y2=\"332\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"78\" y=\"336\" font-size=\"12\" fill=\"#555555\" text-anchor=\"end\">1</text><line x1=\"85\" y1=\"304\" x2=\"95\" y2=\"304\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"78\" y=\"308\" font-size=\"12\" fill=\"#555555\" text-anchor=\"end\">2</text><line x1=\"85\" y1=\"276\" x2=\"95\" y2=\"276\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"78\" y=\"280\" font-size=\"12\" fill=\"#555555\" text-anchor=\"end\">3</text><line x1=\"85\" y1=\"248\" x2=\"95\" y2=\"248\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"78\" y=\"252\" font-size=\"12\" fill=\"#555555\" text-anchor=\"end\">4</text><line x1=\"85\" y1=\"220\" x2=\"95\" y2=\"220\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"78\" y=\"224\" font-size=\"12\" fill=\"#555555\" text-anchor=\"end\">5</text><line x1=\"85\" y1=\"192\" x2=\"95\" y2=\"192\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"78\" y=\"196\" font-size=\"12\" fill=\"#555555\" text-anchor=\"end\">6</text><line x1=\"85\" y1=\"164\" x2=\"95\" y2=\"164\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"78\" y=\"168\" font-size=\"12\" fill=\"#555555\" text-anchor=\"end\">7</text><line x1=\"85\" y1=\"136\" x2=\"95\" y2=\"136\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"78\" y=\"140\" font-size=\"12\" fill=\"#555555\" text-anchor=\"end\">8</text><line x1=\"85\" y1=\"108\" x2=\"95\" y2=\"108\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"78\" y=\"112\" font-size=\"12\" fill=\"#555555\" text-anchor=\"end\">9</text><line x1=\"85\" y1=\"80\" x2=\"95\" y2=\"80\" stroke=\"#333333\" stroke-width=\"1.5\"/><text x=\"78\" y=\"84\" font-size=\"12\" fill=\"#555555\" text-anchor=\"end\">10</text><text x=\"78\" y=\"40\" font-size=\"14\" fill=\"#333333\" font-weight=\"bold\">R</text><circle cx=\"90\" cy=\"360\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"126\" cy=\"332\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"162\" cy=\"304\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"198\" cy=\"276\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"234\" cy=\"248\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"270\" cy=\"220\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"306\" cy=\"192\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"342\" cy=\"164\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"378\" cy=\"136\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"414\" cy=\"108\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/><circle cx=\"450\" cy=\"80\" r=\"7\" fill=\"#E74C3C\" stroke=\"#FFFFFF\" stroke-width=\"2\"/></svg></p>",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            },
            {
               "text": "*Gráfico 1: pontos da tabuada do um.*\n\nVeja! Os pontos sobem um degrau de cada vez, como uma inclinação.",
