            {
               "type": 1,
               "uuid": "79d126c9-39ac-4679-904b-4ab69558e44e",
               "text": "Weisstein, Eric W.",
               "page": "https://mathworld.wolfram.com/Multiplication.html",
               "date_time": {
                  "type": "gregory",
                  "year": "",
                  "month": "",
