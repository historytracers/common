         "smile": "thinking",
         "source_menu": [],
         "text": [
            {
               "text": "#### Vamos Pensar!\n\nNa Yupana, a subtração é realizada usando os mesmos movimentos da adição, mas em ordem inversa?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "1793892a-0bef-4cf5-87a4-750f9c1ed379",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
