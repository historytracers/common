         "source_menu": [],
         "text": [
            {
               "text": "#### Vamos Pensar!\n\nNo *Tawantinsuyu*, a região do Império Inca, quando multiplicamos, fazemos isso de forma completamente diferente da adição?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
