      {
         "id": "83d6ca90-1ae4-4c89-aa5a-4485673f9d2a",
         "audio": "",
         "smile": "thinking",
         "source_menu": [],
         "text": [
            {
               "text": "#### Vamos Pensar!\n\nNa tela anterior, escrevemos 40 como XL em vez de IL.\n\nEssa é a forma correta de representar 40?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "09fe0c29-2dce-4cf8-9732-620a230fa70f",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
      {
         "id": "09fe0c29-2dce-4cf8-9732-620a230fa70f",
         "audio": "",
         "smile": "happy",
         "source_menu": [
            {
               "type": 1,
               "uuid": "23404456-5202-4933-928e-e07cbeea282b",
               "text": "Texto Original",
               "page": "https://www.historytracers.org/index.html?page=class_content&arg=23404456-5202-4933-928e-e07cbeea282b",
               "date_time": {
                  "type": "gregory",
                  "year": "2026",
                  "month": "",
                  "day": ""
               }
            },
            {
               "type": 1,
               "uuid": "a372974f-4cea-4702-852d-40e70e155583",
               "text": "Wheelock, F. (ed. R. LaFleur)",
