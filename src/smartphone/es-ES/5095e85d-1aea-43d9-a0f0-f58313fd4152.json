         "source_menu": [],
         "text": [
            {
               "text": "#### ¡Vamos a Pensar!\n\nSumar el mismo objeto 10 veces da 10. Entregar esos 10 objetos a una sola persona deja a esa persona con los 10.\n\n¿Multiplicar o dividir por uno siempre devuelve el valor del que partimos?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "9664975f-fc57-4bb9-8a4d-7f4486b2af6f",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
