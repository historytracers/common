             },
             {
                "type": 0,
                "uuid": "ad06d072-85a8-4a96-a31b-88a1e08cafd6",
                "text": "ESA. Cuántas estrellas hay en el universo?",
                "page": "https://www.esa.int/Science_Exploration/Space_Science/How_many_stars_are_there_in_the_Universe",
                "date_time": {
                   "type": "gregory",
                   "year": "",
