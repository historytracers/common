         "source_menu": [
            {
               "type": 1,
               "uuid": "a1a7c478-9061-4160-ba43-301c081733e9",
               "text": "ESA",
               "page": "https://www.esa.int/Science_Exploration/Space_Science/Planck/History_of_cosmic_structure_formation",
               "date_time": {
