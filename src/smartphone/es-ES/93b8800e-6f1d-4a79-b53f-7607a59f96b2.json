          "source_menu": [
             {
                "type": 1,
                "uuid": "49878bec-a9fb-40b3-9421-cc86648e7a45",
                "text": "ESA/Gaia/DPAC, S. Payne-Wardenaar, L. McCallum et al",
                "page": "https://www.esa.int/Science_Exploration/Space_Science/Gaia",
                "date_time": {
                   "type": "gregory",
