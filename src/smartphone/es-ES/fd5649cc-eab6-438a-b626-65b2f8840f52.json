         "source_menu": [],
         "text": [
            {
               "text": "#### ¡Pensemos!\n\nEn la Yupana, ¿la resta se realiza usando los mismos movimientos de la suma, pero en orden inverso?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
