         "position": ""
      },
      {
         "id": "9ffe0bb7-4fe6-4b14-88f5-a8c52fda831a",
         "audio": "",
         "smile": "thinking",
         "source_menu": [],
         "text": [
            {
               "text": "#### ¡Pensemos!\n\nEn la Yupana, ¿la resta se realiza usando los mismos movimientos de la suma, pero en orden inverso?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "1793892a-0bef-4cf5-87a4-750f9c1ed379",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
