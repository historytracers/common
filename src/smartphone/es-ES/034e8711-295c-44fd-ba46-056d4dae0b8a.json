            {
               "type": 1,
               "uuid": "3f68de7c-d729-4b62-9bb1-36c6f518fea4",
               "text": "Equipo History Tracers — Simplicidad vs. Complejidad",
               "page": "https://www.historytracers.org/index.html?page=class_content&arg=3f68de7c-d729-4b62-9bb1-36c6f518fea4",
               "date_time": {
