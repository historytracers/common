         "text": [
            {
               "text": "#### ¡Pensemos!\n\nUn quipu registra números usando nudos colocados en órdenes diferentes.\n\n**¿Puede un quipu representar cualquier número?**",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "5e52ae38-07b9-4c41-b50c-d9313c8f3388",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
