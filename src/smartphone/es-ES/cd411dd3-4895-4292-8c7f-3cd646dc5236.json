               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            },
            {
               "text": "*Tabla 2: Las últimas centenas (600 a 1000), comparadas con las últimas decenas (60 a 100).*",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "6ad7d2da-4635-4433-8acb-389621278a72",
