t x=\"300\" y=\"134\" font-size=\"21\" text-anchor=\"middle\" font-weight=\"bold\" fill=\"#333333\">5</text><text x=\"339\" y=\"134\" font-size=\"21\" text-anchor=\"middle\" font-weight=\"bold\" fill=\"#333333\">6</text><text x=\"345\" y=\"89\" font-size=\"21\" text-anchor=\"middle\" font-weight=\"bold\" fill=\"#333333\">7</text><text x=\"364\" y=\"52\" font-size=\"21\" text-anchor=\"middle\" font-weight=\"bold\" fill=\"#333333\">8</text><text x=\"399\" y=\"35\" font-size=\"21\" text-anchor=\"middle\" font-weight=\"bold\" fill=\"#333333\">9</text><text x=\"493\" y=\"84\" font-size=\"21\" text-anchor=\"middle\" font-weight=\"bold\" fill=\"#333333\">10</text></svg>",
