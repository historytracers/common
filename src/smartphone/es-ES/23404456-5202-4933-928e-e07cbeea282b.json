                  "type": "gregory",
                  "year": "2026",
                  "month": "",
                  "day": ""
               }
            }
         ],
         "text": [
            {
               "text": "#### Nada Cambia, Excepto...\n\nUsamos la misma lógica para los números entre las otras decenas, pero debemos prestar atención a un detalle. Primero, mira la tabla de abajo:",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            },
            {
               "text": "<p data-custom=\"etruscan-roman-tens-table-30-40-50\"></p>",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "html",
               "PostMention": ""
            },
            {
               "text": "*Tabla 2: Las decenas 10, 20 y 30, seguidas de 40 y 50.*",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "83d6ca90-1ae4-4c89-aa5a-4485673f9d2a",
         "prev": "",
