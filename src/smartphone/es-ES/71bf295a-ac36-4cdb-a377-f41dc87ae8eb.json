      },
      {
         "id": "b2c8ab54-90cf-4573-80e9-74813e2e4b59",
         "audio": "",
         "smile": "shocking",
         "source_menu": [
            {
               "type": 1,
               "uuid": "b1a262fc-0148-489b-8b70-5266a85c1e67",
               "text": "Texto original",
               "page": "https://www.historytracers.org/index.html?page=class_content&arg=0efc56a7-9597-40a7-b805-2a44e4d5590d",
               "date_time": {
                  "type": "gregory",
