         "text": [
            {
               "text": "#### Pensando\n\nMedir nos dice qué tan largo es un objeto.\n\n¿Podemos usarlo para comprobar si dos objetos son iguales?",
               "source": null,
               "date_time": null,
               "isTable": false,
               "imgdesc": "",
               "format": "markdown",
               "PostMention": ""
            }
         ],
         "desc": null,
         "next": "68b7c7d1-39ee-4b1b-ba17-c74698eefcde",
         "prev": "",
         "jumpTo": "",
         "answer": "yes",
         "score": 2,
         "position": ""
      },
